# Printosk 2.0 Environment Configuration
# Copy this file to .env.local in apps/web before deploying

# 1. Supabase Backend
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Razorpay Payments
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 3. Scheduled Automated Cleanup
CRON_SECRET=generate_a_random_32_char_secret_here

# 4. Kiosk Node Security
KIOSK_API_SECRET_TOKEN=device_token_hash_bbsr001_secret

