{
  "name": "printosk-2",
  "version": "2.0.0",
  "private": true,
  "description": "Cloud-connected QR-based automated printing kiosk",
  "workspaces": [
    "apps/*",
    "services/*",
    "shared/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:processor": "npm run dev --workspace=services/document-processor",
    "build:web": "npm run build --workspace=apps/web",
    "build:shared": "npm run build --workspace=shared/types",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}

